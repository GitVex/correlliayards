# Copy to .env.local and fill in. Never commit the filled-in file.

# Your Zitadel instance. Must match the "issuer" value from
# https://<host>/.well-known/openid-configuration exactly, scheme included.
ZITADEL_ISSUER=https://auth.example.com

# From the Zitadel application. Create a WEB app with authentication
# method CODE — that is the confidential client this server needs.
ZITADEL_CLIENT_ID=
ZITADEL_CLIENT_SECRET=

# Public origin of THIS server. The OIDC redirect URI is derived from it as
# <APP_BASE_URL>/auth/callback, so it must match what Zitadel has registered.
APP_BASE_URL=http://localhost:8080

# Signs the session cookie. At least 32 characters. Generate with:
#   node -p "require('node:crypto').randomBytes(32).toString('base64url')"
# Keep it stable across restarts — changing it logs everyone out.
SESSION_SECRET=

# Optional. Defaults to 8080. Kept separate from APP_BASE_URL because in
# production that URL is the public https origin while the process still
# binds a plain port behind a reverse proxy.
# PORT=8080
