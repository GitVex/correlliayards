# The build stage runs `npm ci` and *then* copies the workspaces in, so anything
# left here gets copied over the result. node_modules is the one that actually
# breaks the build: the host's copy holds @rolldown/binding-win32-x64-msvc, which
# would replace the linux-musl binding npm ci just installed and leave
# `npm run build` with no native binding it can load.
node_modules
**/node_modules
dist
**/dist

.git
.gitignore
.idea
.vscode

*.log
*.stackdump

# Real secrets, and they are gitignored rather than absent — which is exactly
# why they need naming here as well. The serve stages copy only dist/ and
# drizzle/, so none of this reaches a published image, but `COPY apps/api
# apps/api` in the build stage would otherwise put a client secret and a
# database password into a cached layer.
*.local
.env
.env.*
