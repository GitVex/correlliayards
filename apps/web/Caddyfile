{
	admin off
	persist_config off
	auto_https off
}

:8300 {
	root * /srv
	encode zstd gzip

	# Vite fingerprints everything under /assets, so those URLs can never go
	# stale and are cached for a year. Everything else — index.html above all —
	# keeps its name across deploys and has to be revalidated, or a returning
	# visitor is served the old shell pointing at assets that no longer exist.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	# The proxied prefixes are excluded because `header` rewrites what comes back
	# from upstream too, and /auth/me answers `no-store` for a reason — it is a
	# per-session identity. Overwriting that with `no-cache` would let an
	# intermediary keep a copy of one user's claims, which is the exact thing
	# `no-store` is there to forbid. The API sets its own caching; leave it be.
	@document not path /assets/* /api/* /auth/*
	header @document Cache-Control "no-cache"

	# Caddy sorts directives into a hard-coded order rather than the order
	# written, and `try_files` runs before `reverse_proxy` in it. Written flat,
	# /auth/me is rewritten to /index.html before the proxy's path matcher is
	# consulted, and the SPA shell answers every API call with 200 text/html.
	# `handle` blocks are the fix: mutually exclusive, evaluated in order, first
	# match wins, catch-all last.
	#
	# The prefixes are proxied so the browser sees one origin — the session cookie
	# is HttpOnly and SameSite=Lax, so a cross-origin fetch would not carry it.
	handle /api/* {
		reverse_proxy {$API_ORIGIN:http://api:8080}
	}

	handle /auth/* {
		reverse_proxy {$API_ORIGIN:http://api:8080}
	}

	handle {
		try_files {path} /index.html
		file_server
	}
}
